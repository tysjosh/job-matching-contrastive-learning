{
  "domain_adapter": "go_ppi",
  "batch_size": 64,
  "learning_rate": 8.5e-05,
  "num_epochs": 15,
  "temperature": 0.07,
  "negative_sampling_ratio": 0.7,
  "shuffle_data": true,
  "checkpoint_frequency": 500,
  "log_frequency": 10,
  "text_encoder_model": "sentence-transformers/all-mpnet-base-v2",
  "text_encoder_device": null,
  "freeze_text_encoder": true,
  "projection_dim": 128,
  "projection_dropout": 0.3,
  "training_phase": "self_supervised",
  "embedding_cache_path": "embedding_cache/go_ppi_text_embeddings.pt",
  "embedding_cache_size": 30000,
  "enable_embedding_preload": true,
  "clear_cache_between_epochs": false,
  "use_view_augmentation": false,
  "max_resume_views": 1,
  "max_job_views": 1,
  "fallback_on_augmentation_failure": true,
  "go_ppi_go_tiered_negatives": true,
  "go_obo_path": "dataset/go_ppi/bulk/go-basic.obo",
  "go_annotation_path": "dataset/go_ppi/bulk/goa_human.gaf.gz",
  "go_index_cache": "preprocess/go_ppi/go_index_P.pkl",
  "go_aspect": "A",
  "go_alpha": 0.5,
  "go_max_hops": 12,
  "ontology_weight": 0.0,
  "use_ot_distance": false,
  "use_pathway_negatives": false,
  "pathway_weight": 0.0,
  "use_isco_negatives": false,
  "use_reuse_weighting": false,
  "esco_graph_path": null,
  "esco_kg_path": null,
  "esco_occupations_path": null,
  "esco_skills_path": null,
  "global_negative_sampling": false,
  "use_in_batch_negatives": false,
  "max_negatives_per_anchor": 7,
  "hard_negative_max_distance": 2.0,
  "medium_negative_max_distance": 4.0,
  "go_ppi_start_hard_ratio": 0.2,
  "go_ppi_end_hard_ratio": 0.6,
  "go_ppi_go_score_cap": 400,
  "go_ppi_split_dir": "preprocess/go_ppi_splits",
  "go_ppi_converted_dir": "preprocess/go_ppi",
  "loss_type": "go_ordinal",
  "ws2_weight": 0.0,
  "ot_distance_scale": 10.0,
  "validate_every_n_epochs": 1,
  "fixed_validation_negatives": true,
  "validation_negative_epoch": 14,
  "validation_negative_seed": 1729,
  "training_seed": 42,
  "orca_enabled": false,
  "go_ppi_tier_sampling": "stochastic",
  "go_ppi_tier_window_frac": 0.34,
  "go_similarity_mode": "simgic",
  "go_aspect_weights": {
    "P": 1.0,
    "F": 1.0,
    "C": 1.0
  },
  "go_ordinal_lambda_high_weak": 1.0,
  "go_ordinal_lambda_weak_unobserved": 0.1,
  "go_ordinal_margin_high_weak": 0.1,
  "go_ordinal_margin_weak_unobserved": 0.05,
  "go_ordinal_rank_temperature": 0.1
}
