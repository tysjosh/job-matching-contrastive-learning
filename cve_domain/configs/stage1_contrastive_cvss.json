{
  "domain_adapter": "cve",

  "split_strategy": "stratified",
  "split_seed": 42,
  "split_proportions": {
    "train": 80,
    "validation": 10,
    "test": 10
  },

  "max_negatives_per_anchor": 7,
  "negative_tier_ratios": {
    "hard": 0.34,
    "medium": 0.33,
    "easy": 0.33
  },

  "freeze_text_encoder": true,

  "cve_csv_path": "cybersecurity-vulnerability-ranking/data/processed/vulnerability_priority_ranking_nvd_all.csv",
  "cve_profiles_path": "cybersecurity-vulnerability-ranking/data/ontology/cve_ontology_profiles.jsonl",
  "cve_denominator_pools_path": "cybersecurity-vulnerability-ranking/data/ontology/cve_denominator_pools.jsonl",
  "cyber_kg_path": "cybersecurity-vulnerability-ranking/data/ontology/cyber_kg.gexf",

  "training_phase": "self_supervised",
  "loss_type": "ordinal",
  "batch_size": 64,
  "learning_rate": 0.000085,
  "num_epochs": 10,
  "temperature": 0.07,
  "use_view_augmentation": false,
  "ontology_weight": 0.0,
  "use_ot_distance": false,
  "cve_ontology_overlap_weighting": false,

  "_target_comment": "Alternate ordinal target: CVSS base severity (independent of the EPSS-derived priority_score). The converter fills the priority_score/priority_band slots from cvss_base_score (scaled x10 to 0-100) and lower-cased cvss_base_severity, so the whole pipeline is target-agnostic. Leakage stripping stays ON because CVSS is now the label.",
  "cve_target_label": "cvss",
  "cve_exclude_leakage_segments": true,

  "cve_positive_signal": "priority_band",
  "cve_negative_cross_band": true,
  "cve_negative_band_quota": true,
  "cve_negative_band_quota_adjacent_ratio": 0.5,
  "cve_band_order": ["none", "low", "medium", "high", "critical"],
  "ordinal_alpha": 0.5,
  "ordinal_lambda1": 1.0,
  "ordinal_lambda2": 1.0,
  "ordinal_m2": 0.3,
  "ordinal_fixed_m1": false,
  "ordinal_curriculum_switch": 0.3,
  "phi_gate_threshold": 1.0,
  "checkpoint_frequency": 500,
  "log_frequency": 10,
  "shuffle_data": true,
  "text_encoder_model": "sentence-transformers/all-mpnet-base-v2",
  "text_encoder_device": null,
  "encoder_max_seq_length": 512,
  "embedding_cache_size": 400000,
  "enable_embedding_preload": true,
  "embedding_cache_path": "cve_domain/runs/stage1_contrastive_cvss/embedding_cache/text_embeddings.pt",
  "clear_cache_between_epochs": false,
  "projection_dim": 128,
  "projection_dropout": 0.3,
  "pretrained_model_path": null,
  "freeze_contrastive_layers": false,
  "validate_every_n_epochs": 1,

  "output_dir": "cve_domain/runs/stage1_contrastive_cvss",
  "checkpoint_path": "cve_domain/runs/stage1_contrastive_cvss/best_checkpoint.pt",
  "validation_path": "cve_domain/runs/stage1_contrastive_cvss/data_splits/validation.jsonl"
}
